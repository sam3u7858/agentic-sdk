# LLM 主後端（預設 Gemini）
GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# 若改用 OpenAI 相容後端
OPENAI_API_KEY=your_openai_key_here
LM_API_URL=https://api.openai.com/v1

# 網頁搜尋（SandboxWebSearchTool）
GOOGLE_CSE_API_KEY=your_google_cse_key_here
GOOGLE_CSE_ENGINE_ID=your_cse_engine_id_here
# 或 SearchAPI
SEARCH_API_KEY=your_searchapi_key_here

# 次要 LLM（URLSecondaryLLMSummarizer）
SECONDARY_LLM_PROVIDER=gemini
SECONDARY_LLM_MODEL=gemini-3-flash-preview
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_API_URL=
